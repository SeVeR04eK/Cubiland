# =============================================================================
# Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the actual values.
# Never commit .env to version control.
# =============================================================================

# Environment
ENVIRONMENT=development

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=cubiland
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=cubiland
DATABASE_URL=postgresql+asyncpg://cubiland:change_this_password_in_production@db:5432/cubiland

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
RABBITMQ_USER=cubiland
RABBITMQ_PASSWORD=change_this_password_in_production
RABBITMQ_VHOST=/
CELERY_BROKER_URL=amqp://cubiland:change_this_password_in_production@rabbitmq:5672//
CELERY_TASK_DEFAULT_QUEUE=cubiland

# RabbitMQ Management Interface (Development Only)
# Exposed on port 15672 in development
RABBITMQ_MANAGEMENT_PORT=15672

# =============================================================================
# JWT Configuration
# =============================================================================
# Generate a secure random secret key for production
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key
JWT_ISSUER=cubiland
JWT_AUDIENCE=cubiland-api

# =============================================================================
# Resend Email Configuration
# =============================================================================
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Object Storage Configuration (S3-compatible)
# =============================================================================
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=cubiland-media
S3_REGION=us-east-1

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
